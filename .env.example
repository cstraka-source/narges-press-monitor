# Copy this to .env and fill in your keys

# NewsAPI — free at newsapi.org (500 requests/day on free tier)
NEWS_API_KEY=your_newsapi_key_here

# YouTube Data API v3 — free at console.cloud.google.com (10,000 units/day)
YOUTUBE_API_KEY=your_youtube_key_here

# Notion — get from notion.so/my-integrations
# Create an integration, share the target database with it, paste the token here
NOTION_TOKEN=secret_your_notion_token_here
# The database ID from the URL of your Notion press database (create it first, then paste ID)
NOTION_DATABASE_ID=your_database_id_here

# Search query (change if needed)
SEARCH_QUERY=Narges Rashidi
